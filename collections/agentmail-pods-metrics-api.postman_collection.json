        {
          "id": "639ff288-2f21-4ef1-8324-416dc7ad79a1",
          "name": "Query Usage",
          "request": {
            "name": "Query Usage",
            "description": {
              "content": "Cumulative usage series for the pod. Each point is the running total of\nthe usage type at that timestamp, not the change within the bucket.\nPod-scoped queries carry every usage type except `pod_count`; requested\ntypes that don't apply to the scope are ignored. Defaults to the last\n24 hours; `start` must be within the last 90 days, and a future `end`\nis clamped to now. The range divided by `period` must not exceed 1000\nbuckets.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "pods",
                ":pod_id",
                "metrics",
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "usage_types",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "usage_types",
