          "id": "4ae43bb5-a9bc-4656-afbf-132959d32155",
          "name": "Query Usage",
          "request": {
            "name": "Query Usage",
            "description": {
              "content": "Cumulative usage series for the organization. Each point is the running\ntotal of the usage type at that timestamp, not the change within the\nbucket. Defaults to the last 24 hours; `start` must be within the last\n90 days, and a future `end` is clamped to now. The range divided by\n`period` must not exceed 1000 buckets.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "metrics",
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
